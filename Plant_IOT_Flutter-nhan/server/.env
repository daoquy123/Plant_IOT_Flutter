NODE_ENV=production
# Bind all interfaces (required for Nginx reverse proxy on the same host)
HOST=0.0.0.0
PORT=3000
API_KEY=a90cfc28468dc7b73eda44573bebb3a6d39981c92f449a9fc3cda4e56e113ce0
DB_PATH=./data/plant_iot.db
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5
SENSOR_RETENTION_DAYS=30
IMAGE_RETENTION_DAYS=7
LOG_LEVEL=info
# Comma-separated allowed browser origins. Mobile apps often send no Origin (allowed). Empty = allow all.
# Direct IPv4 VPS access.
CORS_ORIGINS=http://103.116.38.192,https://103.116.38.192
# Trust first reverse proxy (Nginx) for X-Forwarded-Proto / client IP
TRUST_PROXY=1

# MQTT broker config (for ESP32 <-> server realtime)
MQTT_URL=mqtt://103.116.38.192:1883
MQTT_CLIENT_ID=plant-server-main
MQTT_USE_API_KEY_AUTH=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Flutter app URLs (public, exposed via GET /api/config — no API key required)
PUBLIC_SERVER_URL=http://103.116.38.192
AI_SERVER_URL=http://103.116.38.192:8000
CAMERA_URL=

# Gmail SMTP (App Password — không dùng mật khẩu đăng nhập thường)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=thachdau0203@gmail.com
EMAIL_HOST_PASSWORD=kpenwdsquryarkxa
DEFAULT_FROM_EMAIL=thachdau0203@gmail.com
REPORT_EMAIL_TO=thachdau0203@gmail.com
EMAIL_REPORTS_ENABLED=true
