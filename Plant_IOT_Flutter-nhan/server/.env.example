NODE_ENV=production
# Bind all interfaces (required for Nginx reverse proxy on the same host)
HOST=0.0.0.0
PORT=3000
API_KEY=a90cfc28468dc7b73eda44573bebb3a6d39981c92f449a9fc3cda4e56e113ce0
DB_PATH=./data/plant_iot.db
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5
SENSOR_RETENTION_DAYS=30
IMAGE_RETENTION_DAYS=7
LOG_LEVEL=info
# Comma-separated allowed browser origins. Mobile apps often send no Origin (allowed). Empty = allow all.
# Direct IPv4 VPS access.
CORS_ORIGINS=http://103.116.38.192,https://103.116.38.192
# Trust first reverse proxy (Nginx) for X-Forwarded-Proto / client IP
TRUST_PROXY=1

# MQTT broker config (ESP32 devices and Node.js server connect to this broker by IPv4).
MQTT_URL=mqtt://103.116.38.192:1883
MQTT_CLIENT_ID=plant-server-main
MQTT_USE_API_KEY_AUTH=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Flutter app URLs (public, exposed via GET /api/config)
PUBLIC_SERVER_URL=http://103.116.38.192
AI_SERVER_URL=http://103.116.38.192:8000
CAMERA_URL=

# Gmail SMTP (App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your@gmail.com
REPORT_EMAIL_TO=your@gmail.com
EMAIL_REPORTS_ENABLED=true

# Pump work session length (seconds) — manual control & auto-water
PUMP_SESSION_SECONDS=60
# Auto water: same session length (optional override)
AUTO_WATER_PUMP_SECONDS=60

# Sensor alert thresholds (email when out of range, max 1/hour if enabled in app)
SENSOR_ALERT_TEMP_MIN=22
SENSOR_ALERT_TEMP_MAX=32
# Ngưỡng ẩm đất an toàn — kiểm tra TB lúc 22:00; thấp hơn → tưới 3 lần/ngày
SENSOR_ALERT_SOIL_MIN=45
SENSOR_ALERT_SOIL_MAX=85
# Lá vàng+ ≥ 10 lần/ngày + ẩm đất ≤ SOIL_MIN+15% → tưới 3 lần (22:00)
LEAF_HEALTH_MIN_UNHEALTHY_COUNT=10
LEAF_HEALTH_SOIL_MAX_OFFSET=15
SENSOR_ALERT_RAIN_MIN=10
SENSOR_ALERT_RAIN_MAX=85
SENSOR_ALERT_HUMIDITY_MIN=45
SENSOR_ALERT_HUMIDITY_MAX=85
