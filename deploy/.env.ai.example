# Copy vào PM2 env hoặc export trước khi chạy plant-ai (tùy VPS).

# Chat Qwen (Ollama local — khuyến nghị)
QWEN_CHAT_ENABLED=1
QWEN_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5:0.5b
QWEN_CHAT_TIMEOUT_SEC=90
QWEN_MAX_HISTORY=12

# Hoặc DashScope / OpenAI-compatible (QWEN_PROVIDER=openai)
# QWEN_PROVIDER=openai
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-...
# QWEN_MODEL=qwen-turbo
